# cp env.sh.example env.sh && edit；env.sh 不進 repo
REPO="$(git rev-parse --show-toplevel)"
export SPACK_ROOT="${SPACK_ROOT:-$HOME/spack}"
export INVDX_MEEP_ENV="$REPO/spack/env/.spack-env/view"
export INVDX_GPU=0
# 若 view 的 bin/python 無法自足 import meep：
# export PYTHONPATH="$INVDX_MEEP_ENV/lib/python3.11/site-packages"
# fallback：指回既有 conda env（尚未建 spack 環境時先用這個）
# export INVDX_MEEP_ENV="$HOME/<your-conda-envs-dir>/envs/meep"

# --- 選用：Lmod module 介面（叢集使用者慣用的 `module load`，非必要） ---
# meep_bridge 不依賴 module，一律走 INVDX_MEEP_ENV；下面這段純粹是給想用
# `module load meep` 的人。兩個 `module use`是因為 spack 預設的 mpi 階層式
# 佈局（meep 掛在 mpich 底下的第二層 Core）；細節見 docs/env.md「Module
# interface」節。
# . "${SPACK_ROOT:-$HOME/spack}/share/spack/setup-env.sh"
# . $(spack -e "$REPO/spack/tools" location -i lmod)/lmod/lmod/init/bash
# LMOD_ROOT="$(spack location -r)/share/spack/lmod/linux-ubuntu22.04-x86_64"
# module use "$LMOD_ROOT/Core"
# module use "$LMOD_ROOT"/mpich/*/Core
# module avail                                    # 應看到 meep/1.34.0
# module load meep
# module load python                              # 見 docs/env.md「pit 4」：
#                                                   # autoload 會連帶拉進 spack
#                                                   # 內部的 python-venv build
#                                                   # helper，蓋掉 PATH 上真正
#                                                   # 的直譯器，重新 load 一次
#                                                   # 把它推回最前面
# module load py-scipy py-matplotlib              # meep 的 python 層執行期會
#                                                   # import 這兩個，但它們不是
#                                                   # meep 宣告的 spack
#                                                   # dependency（只在 view 裡
#                                                   # 被合併），autoload:direct
#                                                   # 看不到，要手動載
# python -c "import meep; print(meep.__version__)"  # -> 1.34.0
