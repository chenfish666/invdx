# cp env.sh.example env.sh && edit；env.sh 不進 repo
REPO="$(git rev-parse --show-toplevel)"
export SPACK_ROOT="${SPACK_ROOT:-$HOME/spack}"
export INVDX_MEEP_ENV="$REPO/spack/env/.spack-env/view"
export INVDX_GPU=0
# 若 view 的 bin/python 無法自足 import meep：
# export PYTHONPATH="$INVDX_MEEP_ENV/lib/python3.11/site-packages"
# fallback：指回既有 conda env（尚未建 spack 環境時先用這個）
# export INVDX_MEEP_ENV="$HOME/<your-conda-envs-dir>/envs/meep"
