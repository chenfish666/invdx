# cp env.sh.example env.sh && edit -- env.sh is gitignored.
REPO="$(git rev-parse --show-toplevel)"
export SPACK_ROOT="${SPACK_ROOT:-$HOME/spack}"
export INVDX_MEEP_ENV="$REPO/spack/env/.spack-env/view"
export INVDX_GPU=0
# If the view's bin/python cannot import meep on its own:
# export PYTHONPATH="$INVDX_MEEP_ENV/lib/python3.11/site-packages"
# Fallback -- point at an existing conda env instead. Use this before the
# spack environment has been built:
# export INVDX_MEEP_ENV="$HOME/<your-conda-envs-dir>/envs/meep"

# --- Optional: Lmod module interface -----------------------------------
# Nothing in the project needs this. meep_bridge only ever reads
# INVDX_MEEP_ENV; the lines below exist for cluster users who would rather
# type `module load meep`.
#
# Two `module use` lines are needed because spack's default module layout is
# hierarchical by MPI: meep sits in a second-level Core underneath mpich, and
# the top-level Core alone will not show it. See "Module interface" in
# docs/env.md.
#
# . "${SPACK_ROOT:-$HOME/spack}/share/spack/setup-env.sh"
# . $(spack -e "$REPO/spack/tools" location -i lmod)/lmod/lmod/init/bash
# LMOD_ROOT="$(spack location -r)/share/spack/lmod/<your-spack-arch>"
# module use "$LMOD_ROOT/Core"
# module use "$LMOD_ROOT"/mpich/*/Core
# module avail                        # meep/1.34.0 should appear
# module load meep
#
# module load python
#   Loading meep autoloads spack's internal python-venv build helper, which
#   shadows the real interpreter on PATH. Loading python again afterwards
#   pushes it back to the front. This is "pit 4" in docs/env.md.
#
# module load py-scipy py-matplotlib
#   meep's python layer imports both at runtime, but neither is a declared
#   spack dependency of meep -- they are merged into the view rather than
#   depended on, so autoload:direct cannot see them and they have to be
#   loaded by hand.
#
# python -c "import meep; print(meep.__version__)"    # -> 1.34.0
